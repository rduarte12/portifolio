{
  "routes": [
    {
      "route": "/research*",
      "rewrite": "/index.html"
    },
    {
      "route": "/projects*",
      "rewrite": "/index.html"
    },
    {
      "route": "/blog*",
      "rewrite": "/index.html"
    },
    {
      "route": "/auth",
      "rewrite": "/index.html"
    },
    {
      "route": "/admin*",
      "rewrite": "/index.html",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/posts",
      "methods": ["POST"],
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/posts/{id}",
      "methods": ["PUT", "DELETE"],
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/analytics/*",
      "allowedRoles": ["admin"]
    }
  ],
  "auth": {
    "rolesSource": "/api/GetRoles"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://*.cloudflareinsights.com;"
  }
}
